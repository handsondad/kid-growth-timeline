# 复制一份叫 .env.local（不进 git），把密码换成你自己的：
#   PowerShell：Copy-Item .env.example .env.local
#   macOS / Linux：cp .env.example .env.local
# 这个文件进 git，里面不要写真的密码。

# 看页面、加密解密用的密码，至少 12 位；几个随机的词连起来最好记。忘了就解不开 vault
TIMELINE_PASSWORD=

# 下面的都可以不写，用默认的
# 图集文件夹（明文），默认项目里的 albums/；放在项目里的话必须被 .gitignore 忽略
# ALBUMS_DIR=albums
# 加密后的 vault，默认项目里的 vault/
# VAULT_DIR=vault
# ffmpeg、ffprobe 不在 PATH 里时
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
# 找不到本机的 Edge / Chrome 时（处理照片、截图用）
# BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# 开着 npm run dev 时不自动加密
# KGT_AUTOSEAL=0
